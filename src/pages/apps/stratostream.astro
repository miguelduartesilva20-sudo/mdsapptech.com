---
import { siteConfig } from "@/config/site";
import { privacyUrl } from "@/config/apps";
import { getAppBySlug } from "@/data/apps";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Section, Button } from "@/components";

const app = getAppBySlug("stratostream")!;
const packageName = "com.stratostream.iptv";

/** The same points the Play listing makes, in the order it makes them. */
const features = [
  {
    title: "The playlists you already own",
    body: "M3U, M3U8 and Xtream Codes. Add one by URL, by Xtream login, or from a file on the device — the same account and the same playlist on your phone, your tablet and your TV box.",
  },
  {
    title: "A full TV guide",
    body: "XMLTV guides load automatically when your playlist declares one, and can be added by hand when it does not. Programme reminders arrive as a notification shortly before something starts.",
  },
  {
    title: "Catch-up and replay",
    body: "Watch what has already aired on channels whose provider offers an archive. Catch-up has no standard, so StratoStream implements all five conventions in circulation — Shift, Flussonic, Xtream timeshift, append and template URLs — and picks the right one per channel.",
  },
  {
    title: "Findable in thousands of channels",
    body: "Favourites, groups and search, so a channel takes a moment rather than a scroll. Picture-in-picture keeps it playing in a corner while you use another app.",
  },
  {
    title: "Built for a remote",
    body: "Android TV and set-top boxes get a leanback layout designed for a d-pad — and no ads at all.",
  },
];
---

<BaseLayout
  title={`${app.name} — ${siteConfig.name}`}
  description={app.description}
>
  <header class="app-hero">
    <div class="container app-hero-inner">
      <div class="app-identity">
        <img src={app.icon} alt="" class="app-mark" width="96" height="96" />
        <div>
          <p class="eyebrow">Our apps</p>
          <h1 class="app-title">{app.name}</h1>
          <p class="app-tagline">{app.tagline}</p>
          <ul class="platforms" aria-label="Supported platforms">
            {app.platforms.map((platform) => <li class="platform-badge">{platform}</li>)}
          </ul>
        </div>
      </div>

      <p class="app-lede">{app.description}</p>

      <div class="app-actions">
        {app.googlePlayUrl && (
          <Button href={app.googlePlayUrl} variant="primary" size="lg" ariaLabel={`${app.name} on Google Play`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.6 1.9a1.5 1.5 0 0 0-.6 1.2v17.8a1.5 1.5 0 0 0 .6 1.2l.1.1 10-10v-.2l-10-10-.1-.1zm13.4 6.6L6.2 2.3l8.6 8.6 2.2-2.4zM6.2 21.7l10.8-6.2-2.2-2.3-8.6 8.5zm12.5-7.3 2.6-1.5c.8-.4.8-1.4 0-1.8l-2.6-1.5-2.5 2.4 2.5 2.4z"/>
            </svg>
            Get it on Google Play
          </Button>
        )}
        <Button href={privacyUrl(app)} variant="secondary" size="lg">Privacy policy</Button>
      </div>

      <p class="app-package">Package <code>{packageName}</code></p>
    </div>
  </header>

  <Section ariaLabel="What StratoStream does" flush>
    <div class="feature-layout">
      <header class="feature-intro">
        <h2 class="section-title">What it does</h2>
        <p class="section-description">
          StratoStream is a player, and only a player. It ships with no channels and no
          subscription: you bring a playlist from a service you already pay for, and it
          plays it.
        </p>
      </header>

      <ul class="feature-list">
        {features.map((feature) => (
          <li class="feature-item">
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-body">{feature.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section ariaLabel="How it is built" tone="muted">
    <div class="detail-grid">
      <article class="detail">
        <h2 class="detail-title">Built for real playlists</h2>
        <p class="detail-body">
          Providers hand out playlists with tens of thousands of channels and guides that
          run to hundreds of megabytes. The guide is streamed straight to storage instead
          of being held in memory, the channel list is paged, and a refresh never leaves
          you with half a playlist if the connection drops.
        </p>
      </article>

      <article class="detail">
        <h2 class="detail-title">Playback</h2>
        <p class="detail-body">
          Hardware decoding with a software fallback, adjustable buffering for unreliable
          providers, tunneled playback for 4K on TV boxes, and per-channel headers for
          providers that require them. HLS, DASH, RTSP and RTMP.
        </p>
      </article>

      <article class="detail">
        <h2 class="detail-title">Your data stays yours</h2>
        <p class="detail-body">
          There is no account to create and no server of ours in the middle. Your
          playlists, credentials and viewing history stay on your device, and playlist
          passwords are stored encrypted. The
          <a href={privacyUrl(app)}>privacy policy</a> sets out exactly what the ads see.
        </p>
      </article>

      <article class="detail">
        <h2 class="detail-title">Free and premium</h2>
        <p class="detail-body">
          The free version is fully functional and supports up to three playlists, with
          ads. One optional payment removes every ad and lifts the playlist limit, for
          good. No subscription.
        </p>
      </article>
    </div>
  </Section>

  <Section ariaLabel="Important">
    <div class="notice-layout">
      <aside class="notice">
        <h2 class="notice-title">Before you install</h2>
        <p class="notice-body">
          StratoStream is a player only. It contains no channels, no streams and no
          content of any kind, and it is not affiliated with any IPTV provider. You need
          your own playlist from a service you already subscribe to. Please make sure you
          have the right to view whatever you play.
        </p>
      </aside>

      <div class="support">
        <h2 class="detail-title">Need a hand?</h2>
        <p class="detail-body">
          Support questions reach the person who wrote the code. Tell us your device
          model and your Android version and we can usually sort it on the first reply.
        </p>
        <p class="support-action">
          <Button href={`mailto:${siteConfig.email}?subject=StratoStream`} variant="secondary">
            {siteConfig.email}
          </Button>
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .app-hero {
    padding: var(--spacing-16) 0 var(--spacing-8);
    background:
      radial-gradient(70% 120% at 15% 0%, rgb(85 73 232 / 0.08), transparent 62%),
      var(--color-bg-primary);
  }

  @media (min-width: 768px) {
    .app-hero {
      padding-top: var(--spacing-20);
    }
  }

  .app-hero-inner {
    max-width: 62ch;
  }

  .app-identity {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
  }

  .app-mark {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    border-radius: var(--radius-2xl);
    object-fit: cover;
    box-shadow: var(--shadow-md);
  }

  .app-title {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
  }

  .app-tagline {
    margin-top: var(--spacing-2);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
  }

  .platforms {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-top: var(--spacing-4);
  }

  .platform-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  .app-lede {
    margin-top: var(--spacing-8);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .app-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    margin-top: var(--spacing-8);
  }

  .app-package {
    margin-top: var(--spacing-5);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .app-package code {
    font-size: 0.95em;
  }

  .section-title {
    font-size: clamp(1.875rem, 3.4vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-4);
  }

  .section-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* Same editorial split as the home page: heading column, content column. */
  .feature-layout {
    display: grid;
    gap: var(--spacing-10);
    align-items: start;
  }

  @media (min-width: 960px) {
    .feature-layout {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--spacing-16);
    }
  }

  .feature-intro {
    max-width: 34em;
  }

  .feature-list {
    list-style: none;
    display: grid;
    gap: var(--spacing-6);
  }

  .feature-item {
    padding-left: var(--spacing-5);
    border-left: 2px solid var(--color-border-strong);
  }

  .feature-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-2);
  }

  .feature-body {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .detail-grid {
    display: grid;
    gap: var(--spacing-8);
  }

  @media (min-width: 860px) {
    .detail-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-10) var(--spacing-16);
    }
  }

  .detail-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-3);
  }

  .detail-body {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .notice-layout {
    display: grid;
    gap: var(--spacing-10);
    align-items: start;
  }

  @media (min-width: 860px) {
    .notice-layout {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--spacing-16);
    }
  }

  .notice {
    padding: var(--spacing-6);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brand-500);
    border-radius: var(--radius-2xl);
    background: var(--color-bg-elevated);
  }

  .notice-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-3);
  }

  .notice-body {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .support-action {
    margin-top: var(--spacing-5);
  }
</style>
