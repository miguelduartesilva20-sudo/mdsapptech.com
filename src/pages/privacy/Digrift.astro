---
import AppPrivacyPolicy from "@/components/AppPrivacyPolicy.astro";

// Confirmed with the developer on 2026-10-15: AdMob ads only (no in-app
// purchase), audience includes children (Google Play Families), no online
// services, and only game progress is saved. Update these flags — and
// lastUpdated — if the app changes. Fill in packageName and googlePlayUrl once
// the listing exists.
const policy = {
  name: "Digrift",
  kind: "a game",
  platforms: ["Android"],
  packageName: null,
  googlePlayUrl: null,
  lastUpdated: "2026-10-15",
  ads: true,
  purchases: false,
  forChildren: true,
  stored: [
    { what: "Game progress", why: "The levels you have reached and what you have unlocked, so you can pick up where you left off." },
  ],
};
---

<AppPrivacyPolicy {...policy} />
