---
import { siteConfig } from "@/config/site";
import { privacyUrl } from "@/config/apps";
import { getAllApps } from "@/data/apps";
import LegalLayout from "@/layouts/LegalLayout.astro";

const apps = getAllApps();
---

<LegalLayout
  title={`Privacy Policy — ${siteConfig.name}`}
  description={`How ${siteConfig.name} handles data on mdsapptech.com, and where to find the privacy policy for each of our apps.`}
  heading="Privacy Policy"
  lastUpdated={siteConfig.legal.privacyLastUpdated}
  currentPath="/privacy/"
>
  <p slot="scope" class="legal-scope">
    This policy covers this website (<code>{siteConfig.url}</code>) only.
    Each application has its own privacy policy, listed below.
  </p>

  <section>
    <h2>Privacy policies for our apps</h2>
    <p>
      Every app we publish has a separate policy describing exactly what that app does with
      your data. These are the pages linked from the Google Play and App Store listings.
    </p>
    <ul>
      {apps.map((app) => (
        <li>
          <a href={privacyUrl(app)}>{app.name} — Privacy Policy</a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>1. Who we are</h2>
    <p>
      {siteConfig.name} is an independent app studio operating this website and the
      applications listed on it. You can reach us at
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
    </p>
  </section>

  <section>
    <h2>2. Information this website collects</h2>
    <p>
      None. This site is a set of static pages. There are no accounts, no contact forms,
      no newsletter and no comment sections, so there is nothing for us to collect.
    </p>
    <p>
      If you email us, we receive whatever you choose to put in your message — your email
      address and the content of it. We use it only to reply to you.
    </p>
  </section>

  <section>
    <h2>3. Cookies and tracking</h2>
    <p>
      This website sets no cookies and uses no <code>localStorage</code>,
      <code>sessionStorage</code>, fingerprinting or any other client-side tracking.
      No analytics service is loaded — no Google Analytics, no Matomo, no Plausible,
      nothing of that kind.
    </p>
  </section>

  <section>
    <h2>4. Hosting and server logs</h2>
    <p>
      The site is hosted on GitHub Pages. Like any web host, GitHub's servers process the
      technical information your browser sends with each request — your IP address, user
      agent and the page requested — for security and to deliver the page. We do not have
      access to those logs. GitHub's handling of that data is described in the
      <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub Privacy Statement</a>.
    </p>
  </section>

  <section>
    <h2>5. Third-party content on this site</h2>
    <p>
      The only external resource these pages load is the Inter font family from Google Fonts.
      When your browser fetches the font files, Google receives your IP address; Google states
      that Google Fonts sets no cookies. See the
      <a href="https://developers.google.com/fonts/faq/privacy" target="_blank" rel="noopener noreferrer">Google Fonts privacy FAQ</a>.
    </p>
    <p>
      Everything else on the page — styles, images, icons — is served from this domain.
    </p>
  </section>

  <section>
    <h2>6. Links to other websites</h2>
    <p>
      This site links to app store listings and, in some cases, to a dedicated website for an
      app. Once you follow such a link, the privacy policy of that site applies instead of
      this one. We are not responsible for the content or practices of sites we link to.
    </p>
  </section>

  <section>
    <h2>7. Your rights</h2>
    <p>
      Because we hold no personal data from your visit, there is nothing for us to give you
      access to, correct or erase. If you have emailed us and would like that correspondence
      deleted, ask and we will delete it.
    </p>
    <p>
      Rights over the data our apps process are described in each app's own policy.
    </p>
  </section>

  <section>
    <h2>8. Children</h2>
    <p>
      This website is not directed at children and knowingly collects no information from
      anyone, of any age.
    </p>
  </section>

  <section>
    <h2>9. Changes to this policy</h2>
    <p>
      If this policy changes, the <strong>Last updated</strong> date at the top of the page
      changes with it. Material changes to an app's policy are noted on that app's page.
    </p>
  </section>

  <section>
    <h2>10. Contact</h2>
    <p>Questions about this policy or about any of our apps:</p>
    <address>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </address>
  </section>
</LegalLayout>
