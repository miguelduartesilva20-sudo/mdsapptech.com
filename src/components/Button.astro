---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  disabled = false,
  type = "button",
  class: className = "",
  ariaLabel,
} = Astro.props;

const isLink = !!href;

const baseStyles = `
  inline-flex items-center justify-center font-medium transition-all duration-200 ease-out
  rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2
  disabled:opacity-50 disabled:cursor-not-allowed
`;

const variantStyles = {
  primary: `
    gradient-bg text-white shadow-md hover:shadow-lg active:scale-[0.98]
    disabled:shadow-none
  `,
  secondary: `
    bg-neutral-100 text-neutral-900 hover:bg-neutral-200 active:scale-[0.98]
    dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-700
  `,
  outline: `
    border-2 border-neutral-300 text-neutral-700 hover:bg-neutral-100 active:scale-[0.98]
    dark:border-neutral-600 dark:text-neutral-300 dark:hover:bg-neutral-800
  `,
  ghost: `
    text-neutral-700 hover:bg-neutral-100 active:scale-[0.98]
    dark:text-neutral-300 dark:hover:bg-neutral-800
  `,
};

const sizeStyles = {
  sm: "px-4 py-2 text-sm gap-2",
  md: "px-6 py-3 text-base gap-2",
  lg: "px-8 py-4 text-lg gap-3",
};

const classList = [baseStyles, variantStyles[variant], sizeStyles[size], className].join(" ");
---

<style>
  .btn-wrapper {
    display: contents;
  }
</style>

<div class="btn-wrapper">
  {isLink ? (
    <a
      class={classList}
      href={href}
      aria-disabled={disabled}
      aria-label={ariaLabel}
      rel={variant === "primary" ? "noopener noreferrer" : undefined}
    >
      <slot />
    </a>
  ) : (
    <button
      class={classList}
      type={type}
      disabled={disabled}
      aria-disabled={disabled}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )}
</div>