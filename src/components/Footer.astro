---
import { siteConfig } from "@/config/site";
import { privacyUrl } from "@/config/apps";
import { getAllApps } from "@/data/apps";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const currentYear = new Date().getFullYear();
const isHome = currentPath === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
const apps = getAllApps();
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo" aria-label={`${siteConfig.name} - Home`}>
          <span class="logo-mark" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="100" height="100" rx="25" class="gradient-bg"/>
              <polygon points="18,78 18,22 32,22 50,50 68,22 82,22 82,78 69,78 69,45 55,66 45,66 31,45 31,78" fill="white"/>
        </svg>
          </span>
          <span class="logo-text">{siteConfig.name}</span>
        </a>
        <p class="tagline">We build focused digital products designed around simplicity, performance and usability.</p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <h3 class="footer-heading">Company</h3>
        <ul>
          <li><a href={anchor("apps")}>Our Apps</a></li>
          <li><a href={anchor("about")}>About Us</a></li>
          <li><a href={anchor("contact")}>Contact</a></li>
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Legal">
        <h3 class="footer-heading">Legal</h3>
        <ul>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="App privacy policies">
        <h3 class="footer-heading">App Policies</h3>
        <ul>
          {apps.map((app) => (
            <li><a href={privacyUrl(app)}>{app.name}</a></li>
          ))}
        </ul>
      </nav>

      {siteConfig.developerProfiles.googlePlay || siteConfig.developerProfiles.appStore || siteConfig.developerProfiles.github ? (
        <>
          <nav class="footer-nav" aria-label="Developer profiles">
            <h3 class="footer-heading">Developer Profiles</h3>
            <ul class="dev-links">
              {siteConfig.developerProfiles.googlePlay && (
                <li>
                  <a href={siteConfig.developerProfiles.googlePlay} target="_blank" rel="noopener noreferrer" aria-label="Google Play Developer Profile">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12.93 13.48c-.72 1.88-2.91 2.37-4.64 1.43-2.07-1.13-3.17-3.27-2.58-5.59.78-3.05 3.84-3.61 4.54-1.42.66 2.1-1.45 4.54-3.58 5.58zm4.89-2.06c.92-2.79-.97-4.62-3.58-5.16-1.8-.36-3.77 1.04-4.54 3.43-.9 2.69 1.8 4.75 4.35 4.62 1.45-.08 2.86-.82 3.77-2.89zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                    </svg>
                    Google Play
                  </a>
                </li>
              )}
              {siteConfig.developerProfiles.appStore && (
                <li>
                  <a href={siteConfig.developerProfiles.appStore} target="_blank" rel="noopener noreferrer" aria-label="Apple App Store Developer Profile">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.71 14.37c-.27-.45-.68-.77-1.2-.94-.48-.15-1.57-.45-3.35-.45-1.87 0-2.93.3-3.55.48-.84.22-1.06.28-1.26.34-.1.02-.21.05-.3.09-.18.08-.24.24-.09.36 1.66 1.37 2.43 3.09 2.43 4.77 0 1.5-.71 2.75-1.98 3.27-.58.24-1.24.3-1.85.18-.27-.05-.52-.03-.76.08-.51.2-.96.4-1.27.49-.37.12-2.58-.38-2.82-.61-.13-.12-.1-.28.08-.36.1-.04.21-.05.3-.02.5.06 1.13.23 1.66.5.35.17.68.37.98.63.13.1.28.2.44.29.16.1.35.15.6.08.55-.15.75-.51.57-.9-.11-.25-.18-.52-.3-.8-.12-.27-.2-.6-.2-.95 0-.1.06-.2.16-.3.28-.28 1.27-.86 2.28-1.82 1.06-1 1.83-2.23 2.03-3.51.05-.4.02-.73-.09-.99zm-5.07-1.06c-1.34-.76-1.88-1.86-1.6-3.07.18-.7.57-1.24 1.13-1.62 1.31-.9 2.97-.93 4.13-.13 1.2.84 1.61 2.17 1.09 3.3-.46.94-1.53 1.51-2.76 1.52zm-5.3-4.88c.27.4.68.69 1.2.92.48.2 1.57.55 3.35.55 1.79 0 2.9-.3 3.55-.48.85-.2 1.06-.27 1.26-.33.1-.02.21-.05.3-.09.18-.08.24-.24.09-.36-1.66-1.37-2.43-3.09-2.43-4.77 0-1.5.71-2.75 1.98-3.27.58-.24 1.24-.3 1.85-.18.27.05.52.03.76-.08.51-.2.96-.4 1.27-.49.37-.12 2.58.38 2.82.61.13.12.1.28-.08.36-.1.04-.21.05-.3.02-.5-.06-1.13-.23-1.66-.5-.35-.17-.68-.37-.98-.63-.13-.1-.28-.2-.44-.29-.16-.1-.35-.15-.6-.08-.55.15-.75.51-.57.9.11.25.18.52.3.8.12.27.2.6.2.95 0 .1-.06.2-.16.3-.28.28-1.27.86-2.28 1.82-1.06 1-1.83 2.23-2.03 3.51-.05.4-.02.73.09.99zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                    </svg>
                    App Store
                  </a>
                </li>
              )}
              {siteConfig.developerProfiles.github && (
                <li>
                  <a href={siteConfig.developerProfiles.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub Profile">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                    </svg>
                    GitHub
                  </a>
                </li>
              )}
            </ul>
          </nav>
        </>
      ) : null}
    </div>

    <div class="footer-bottom">
      <p class="copyright">&copy; {currentYear} {siteConfig.name}. All rights reserved.</p>
      <p class="made-with"><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-16) 0 var(--spacing-8);
  }

  .footer-grid {
    display: grid;
    gap: var(--spacing-10);
    margin-bottom: var(--spacing-12);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 2fr repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-4);
  }

  .logo-mark {
    flex-shrink: 0;
  }

  .tagline {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    max-width: 280px;
    line-height: var(--line-height-relaxed);
  }

  .footer-heading {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-4);
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .footer-nav a {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-nav a:hover,
  .footer-nav a.active {
    color: var(--color-text-primary);
  }

  .dev-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .dev-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .dev-links a:hover {
    color: var(--color-text-primary);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-2);
    padding-top: var(--spacing-8);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .copyright {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .made-with {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
</style>