---
interface Props {
  id?: string;
  class?: string;
  ariaLabel?: string;
  /** "muted" paints the tinted band. It has to be a prop rather than a class
      from the parent: scoped styles do not cross the component boundary. */
  tone?: "default" | "muted";
  /** Tightens the top padding when a section follows a related one. */
  flush?: boolean;
}

const { id, class: className = "", ariaLabel, tone = "default", flush = false } = Astro.props;
---

<section
  id={id}
  class={["section", tone === "muted" && "section-muted", flush && "section-flush", className]
    .filter(Boolean)
    .join(" ")}
  aria-label={ariaLabel}
  role={ariaLabel ? "region" : undefined}
>
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .section {
    padding: var(--spacing-16) 0;
  }

  @media (min-width: 768px) {
    .section {
      padding: var(--spacing-20) 0;
    }
  }

  .section-flush {
    padding-top: var(--spacing-8);
  }

  .section-muted {
    background: var(--color-bg-secondary);
    border-block: 1px solid var(--color-border);
  }
</style>
