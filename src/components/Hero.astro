---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-content">
      <p class="hero-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        Mobile apps &amp; web pages
      </p>

      <h1 id="hero-title" class="hero-title">
        A small studio.<br />Apps built <span class="gradient-text">properly</span>.
      </h1>

      <p class="hero-description">
        MDS AppTech is a very small but dedicated team. We build mobile applications and
        simple web pages for a wide range of purposes &mdash; each one focused, light and
        made to do its job well.
      </p>

      <div class="hero-actions">
        <Button href="#apps" variant="primary" size="lg">Our apps</Button>
        <Button href="#about" variant="outline" size="lg">About us</Button>
      </div>

      <p class="hero-note">
        No trackers we do not need. Every app's privacy policy is
        <a href="/privacy/">published here</a>.
      </p>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="mark-halo"></div>
      <div class="mark">
        <!-- Wrapper, not the component itself: scoped styles from this file
             do not cross into Logo.astro. -->
        <div class="mark-ring"><Logo size={340} variant="full" label={null} /></div>
        <span class="mark-word">MDS</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--spacing-20) 0 var(--spacing-24);
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: var(--spacing-24) 0 var(--spacing-20);
    }
  }

  /* One soft wash instead of the pair of drifting blobs that used to sit
     here - those read as decoration, this reads as light. */
  .hero-glow {
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 120%;
    background:
      radial-gradient(60% 55% at 72% 22%, rgb(85 73 232 / 0.14) 0%, transparent 62%),
      radial-gradient(45% 45% at 88% 58%, rgb(24 184 210 / 0.12) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--spacing-16);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .container {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--spacing-12);
    }
  }

  .hero-content {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .hero-content {
      text-align: left;
      margin: 0;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: 0.4rem 0.9rem 0.4rem 0.6rem;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-6);
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-accent-start), var(--color-accent-end));
    box-shadow: 0 0 0 3px rgb(85 73 232 / 0.12);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6.2vw, 4.25rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-display);
    line-height: 1.04;
    margin-bottom: var(--spacing-6);
  }

  .hero-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-8);
    max-width: 32em;
  }

  @media (min-width: 1024px) {
    .hero-description {
      margin-left: 0;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .hero-note {
    margin-top: var(--spacing-6);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .hero-note a {
    color: var(--color-brand-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* Visual */
  .hero-visual {
    position: relative;
    display: none;
    place-items: center;
    aspect-ratio: 1;
    max-width: 460px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .hero-visual {
      display: grid;
    }
  }

  .mark-halo {
    position: absolute;
    inset: 8%;
    border-radius: var(--radius-full);
    background: radial-gradient(circle at 50% 50%, rgb(85 73 232 / 0.16), rgb(24 184 210 / 0.10) 55%, transparent 70%);
    filter: blur(28px);
  }

  .mark {
    position: relative;
    display: grid;
    place-items: center;
  }

  /* Only the ring turns; the wordmark is a separate element on top so it
     stays upright. */
  .mark-ring {
    animation: orbit 90s linear infinite;
  }

  .mark-word {
    position: absolute;
    font-size: 2.75rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    background: linear-gradient(115deg, var(--color-accent-start), var(--color-accent-mid) 52%, var(--color-accent-text-end));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  @keyframes orbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark-ring { animation: none; }
  }
</style>
